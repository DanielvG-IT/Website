---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export const getStaticPaths = (async () => {
  const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order
  );

  // Neighbours are resolved here rather than in the page body: the collection
  // is already sorted and in scope, and it keeps the page a pure render.
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: projects[i - 1],
      next: projects[i + 1],
    },
  }));
}) satisfies GetStaticPaths;

const { project, prev, next } = Astro.props;
const { title, summary, status, technologies, outcomes, repo, link } =
  project.data;

// `render` is the Astro 5+ form; the old `entry.render()` method is gone.
const { Content } = await render(project);
---

<Layout title={title} description={summary}>
  <article>
    <header class="head">
      <div class="glow" aria-hidden="true"></div>

      <div class="wrap head-inner">
        <nav class="back" aria-label="Breadcrumb">
          <a href="/projects" class="arrow-link">
            <span aria-hidden="true">←</span> All projects
          </a>
        </nav>

        <p class="section-label">{status}</p>
        <h1>{title}</h1>
        <p class="lede">{summary}</p>

        {
          (repo || link) && (
            <div class="links">
              {repo && (
                <a
                  class="btn"
                  href={repo}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  View source
                </a>
              )}
              {link && (
                <a
                  class="btn btn--primary"
                  href={link}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Visit project
                  <span class="arrow" aria-hidden="true">
                    →
                  </span>
                </a>
              )}
            </div>
          )
        }
      </div>
    </header>

    <div class="wrap body">
      <div class="prose content">
        <Content />
      </div>

      <aside class="meta">
        {
          technologies.length > 0 && (
            <section class="surface panel">
              <h2>Technologies</h2>
              <ul class="tags">
                {technologies.map((t) => (
                  <li class="tag">{t}</li>
                ))}
              </ul>
            </section>
          )
        }

        {
          outcomes.length > 0 && (
            <section class="surface panel">
              <h2>What I learned</h2>
              <ul class="outcomes">
                {outcomes.map((o) => (
                  <li>{o}</li>
                ))}
              </ul>
            </section>
          )
        }
      </aside>
    </div>

    {
      (prev || next) && (
        <nav class="wrap pager" aria-label="Projects">
          {prev ? (
            <a class="pager-link prev" href={`/projects/${prev.id}`}>
              <span class="pager-label">
                <span aria-hidden="true">←</span> Previous
              </span>
              <span class="pager-title">{prev.data.title}</span>
            </a>
          ) : (
            <span />
          )}

          {next && (
            <a class="pager-link next" href={`/projects/${next.id}`}>
              <span class="pager-label">
                Next <span aria-hidden="true">→</span>
              </span>
              <span class="pager-title">{next.data.title}</span>
            </a>
          )}
        </nav>
      )
    }
  </article>
</Layout>

<style>
  .head {
    position: relative;
    overflow: hidden;
    padding-block: clamp(1.75rem, 5vw, 2.75rem) clamp(1.5rem, 4vw, 2.5rem);
  }

  .glow {
    top: -14rem;
    right: -8rem;
    width: 34rem;
    height: 24rem;
    background: var(--glow-1);
  }

  .head-inner {
    position: relative;
    z-index: 1;
  }

  .back {
    margin-bottom: 2rem;
  }

  .back a {
    color: var(--text-muted);
  }

  .back a:hover {
    color: var(--accent);
  }

  .head h1 {
    /* Project names are short; the hero size would overwhelm the summary. */
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    margin-block: 1.1rem 1.1rem;
  }

  .links {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 1.75rem;
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 18rem;
    gap: clamp(2rem, 5vw, 3.5rem);
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
    align-items: start;
  }

  .content :global(h2) {
    font-size: 1.375rem;
    margin-top: 2.25rem;
  }

  .content :global(h2:first-child) {
    margin-top: 0;
  }

  .content :global(p) {
    color: var(--text-muted);
    margin-top: 0.85rem;
  }

  .content :global(ul) {
    color: var(--text-muted);
    margin-top: 0.85rem;
    display: grid;
    gap: 0.4rem;
  }

  /* ── Sidebar ───────────────────────────────────────────────── */

  .panel {
    padding: 1.4rem;
  }

  .panel + .panel {
    margin-top: 1rem;
  }

  .meta h2 {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 500;
    margin-bottom: 1rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .outcomes {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }

  .outcomes li {
    position: relative;
    padding-left: 1.15rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .outcomes li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 5px;
    height: 5px;
    border-radius: 1.5px;
    background: var(--gradient);
  }

  /* ── Pager ─────────────────────────────────────────────────── */

  .pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: clamp(3rem, 7vw, 4.5rem);
    padding-top: clamp(1.5rem, 4vw, 2rem);
    border-top: 1px solid var(--border);
  }

  .pager-link {
    display: grid;
    gap: 0.35rem;
    padding: 1.1rem 1.35rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .pager-link:hover {
    color: inherit;
    border-color: var(--border-strong);
    background: var(--bg-subtle);
  }

  .next {
    text-align: right;
  }

  .pager-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .pager-title {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .pager-link:hover .pager-title {
    color: var(--accent);
  }

  /* The sidebar becomes a two-up row before it stacks entirely, so the
     technologies and outcomes panels do not each span the full width. */
  @media (max-width: 58rem) {
    .body {
      grid-template-columns: minmax(0, 1fr);
    }

    .meta {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
      gap: 1rem;
    }

    .panel + .panel {
      margin-top: 0;
    }
  }
</style>
