---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { USES } from '../data/uses';
---

<Layout
  title="Uses"
  description="The hardware, software, platforms, and technologies I use to build, develop, and work with systems."
>
  <PageHeader label="Uses">
    <span slot="title">What I actually use.</span>
    The hardware, software, platforms, and technologies that are part of my
    day-to-day work, development, and projects. This is about what I actually
    use rather than a list of everything I have ever touched.
  </PageHeader>

  <div class="wrap">
    <div class="groups">
      {
        USES.map((group) => (
          <section class="group surface">
            <h2>{group.title}</h2>

            <dl>
              {group.items.map((item) => (
                <div class="row">
                  <dt>{item.name}</dt>
                  {item.note && <dd>{item.note}</dd>}
                </div>
              ))}
            </dl>
          </section>
        ))
      }
    </div>
  </div>
</Layout>

<style>
  .groups {
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    gap: 1rem;
    align-items: start;
  }

  .group {
    padding: 1.6rem;
  }

  .group h2 {
    font-size: 0.72rem;
    font-family: var(--font-mono);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.25rem;
  }

  dl {
    margin: 0;
    display: grid;
    gap: 1rem;
  }

  .row + .row {
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  dt {
    font-weight: 600;
    font-size: 0.9375rem;
  }

  dd {
    margin: 0.15rem 0 0;
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.55;
  }
</style>