---
import Layout from '../layouts/Layout.astro';
import { NOW } from '../data/now';

const updated = new Date(NOW.updated);
const formatted = updated.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Layout
  title="Now"
  description="What I am working on, learning, and building at the moment."
>
  <div class="wrap page">
    <header class="head">
      <p class="eyebrow">Now</p>
      <h1>What I am focused on right now.</h1>
      <p class="lede">{NOW.intro}</p>
      <p class="updated">
        Last updated <time datetime={NOW.updated}>{formatted}</time>
      </p>
    </header>

    <div class="sections">
      {
        NOW.sections.map((s) => (
          <section>
            <h2>{s.title}</h2>
            <ul>
              {s.items.map((i) => (
                <li>{i}</li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <p class="muted note">
      This is a <a href="https://nownownow.com/about" target="_blank" rel="noopener noreferrer">now page</a>.
      It describes a point in time, not a permanent position.
    </p>
  </div>
</Layout>

<style>
  .page {
    padding-block: clamp(2.5rem, 7vw, 4rem) 0;
  }

  .head h1 {
    margin-block: 0.75rem 1rem;
  }

  .updated {
    margin-top: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .sections {
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
    display: grid;
    gap: clamp(2rem, 5vw, 2.5rem);
  }

  .sections h2 {
    font-size: 1.125rem;
    margin-bottom: 0.85rem;
  }

  .sections ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.55rem;
    max-width: var(--measure);
  }

  .sections li {
    position: relative;
    padding-left: 1.25rem;
    color: var(--text-muted);
  }

  .sections li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--text-faint);
  }

  .note {
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.875rem;
  }
</style>
