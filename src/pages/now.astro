---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { NOW } from '../data/now';

const updated = new Date(NOW.updated);
const formatted = updated.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Layout
  title="Now"
  description="What I am learning, building, and focusing on right now."
>
  <PageHeader label="Now" meta={`Updated ${formatted}`}>
    <span slot="title">What I am focused on right now.</span>
    {NOW.intro}
  </PageHeader>

  <div class="wrap">
    <div class="sections">
      {
        NOW.sections.map((s, i) => (
          <section class="block surface">
            <div class="block-head">
              <span class="num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>

              <h2>{s.title}</h2>
            </div>

            <ul>
              {s.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <p class="muted note">
      This is a <a
        href="https://nownownow.com/about"
        target="_blank"
        rel="noopener noreferrer"
      >
        now page
      </a
      >. It captures what matters to me at this point in time rather than
      trying to describe my entire life or career.
    </p>
  </div>
</Layout>

<style>
  .sections {
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1rem;
    align-items: start;
  }

  .block {
    padding: 1.6rem;
  }

  .block-head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding-bottom: 0.9rem;
    margin-bottom: 1.1rem;
    border-bottom: 1px solid var(--border);
  }

  .num {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--accent);
  }

  .block h2 {
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }

  .block ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.8rem;
  }

  .block li {
    position: relative;
    padding-left: 1.15rem;
    color: var(--text-muted);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .block li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 5px;
    height: 5px;
    border-radius: 1.5px;
    background: var(--gradient);
  }

  .note {
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.875rem;
  }

  .note a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
</style>