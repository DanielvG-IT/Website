---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { EMAIL, SOCIALS } from '../consts';

// Reframed from the previous "looking for an internship" wording, which no
// longer holds — that search is over.
const welcome = [
  'Conversations about .NET, TypeScript, React, APIs, and systems-aware engineering.',
  'Collaborative work where learning, structure, and technical quality are central.',
  'Opportunities that follow on from my upcoming internship at Basic-Fit.',
];

const channels = [
  {
    label: 'Email',
    value: EMAIL,
    href: `mailto:${EMAIL}`,
    note: 'The most reliable way to reach me.',
    external: false,
  },
  {
    label: 'LinkedIn',
    value: '/in/danielvanginneken',
    href: SOCIALS.linkedin,
    note: 'Background, education, and experience.',
    external: true,
  },
  {
    label: 'GitHub',
    value: '@DanielvG-IT',
    href: SOCIALS.github,
    note: 'The code behind the projects, including this site.',
    external: true,
  },
];
---

<Layout
  title="Contact"
  description="Open to technical discussions, collaborations, and opportunities in software development."
>
  <PageHeader label="Contact">
    <span slot="title">Open to the right conversations.</span>
    I'm starting an internship with the IT/AI team at Basic-Fit on 31 August,
    and I'm open to technical discussions, collaborations, and opportunities
    that fit my current stage of development.
  </PageHeader>

  <div class="wrap">
    <div class="channels">
      {
        channels.map((c) => (
          <a
            class="channel surface"
            href={c.href}
            target={c.external ? '_blank' : undefined}
            rel={c.external ? 'noopener noreferrer' : undefined}
          >
            <span class="label">{c.label}</span>
            <span class="value">{c.value}</span>
            <span class="note">{c.note}</span>
            <span class="arrow" aria-hidden="true">
              →
            </span>
          </a>
        ))
      }
    </div>

    <section class="block">
      <p class="section-label">Scope</p>
      <h2>What I am open to</h2>
      <ul class="welcome">
        {welcome.map((w) => <li>{w}</li>)}
      </ul>
      <p class="muted response">
        I respond to relevant professional enquiries, usually within two working
        days.
      </p>
    </section>
  </div>
</Layout>

<style>
  .channels {
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 1rem;
  }

  .channel {
    position: relative;
    display: grid;
    /* Fixed rows so the value line sits at the same height in every card,
       regardless of how long the note wraps. */
    grid-template-rows: auto auto 1fr;
    gap: 0.35rem;
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .channel:hover {
    color: inherit;
    transform: translateY(-3px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
  }

  .label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .value {
    font-weight: 600;
    /* Long addresses must not push the card wider than its grid track. */
    overflow-wrap: anywhere;
  }

  .channel:hover .value {
    color: var(--accent);
  }

  .note {
    font-size: 0.875rem;
    color: var(--text-muted);
    padding-right: 1.5rem;
  }

  .arrow {
    position: absolute;
    top: 1.4rem;
    right: 1.4rem;
    color: var(--text-faint);
    transition:
      transform 0.2s ease,
      color 0.2s ease;
  }

  .channel:hover .arrow {
    color: var(--accent);
    transform: translate(3px, -3px);
  }

  .block {
    margin-top: clamp(3rem, 7vw, 4.5rem);
    padding-top: clamp(2rem, 5vw, 3rem);
    border-top: 1px solid var(--border);
  }

  .block h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-top: 0.9rem;
  }

  .welcome {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    gap: 0.85rem;
    max-width: var(--measure);
  }

  .welcome li {
    position: relative;
    padding-left: 1.5rem;
    color: var(--text-muted);
  }

  .welcome li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 6px;
    height: 6px;
    border-radius: 2px;
    background: var(--gradient);
  }

  .response {
    margin-top: 1.75rem;
    font-size: 0.9rem;
  }
</style>
