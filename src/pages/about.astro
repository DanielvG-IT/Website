---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import SocialLinks from '../components/SocialLinks.astro';
import portrait from '../images/portrait.jpg';

const sections = [
  {
    title: 'I started with IT, not software',
    paragraphs: [
      'My background is in IT systems, infrastructure, and support. Before I was focused on software development, I was already working with the systems that software depends on: networks, servers, endpoints, cloud services, monitoring, and production environments.',
      'That experience shaped the way I think about technology. I naturally look beyond whether something works and ask what happens when it fails, how it is maintained, and what the people using it actually need.',
    ],
  },
  {
    title: 'Working with real systems changed how I think',
    paragraphs: [
      'Working in real IT environments taught me that technical decisions always have consequences. A configuration change can affect an entire customer environment, and a small mistake can become someone else’s problem.',
      'That gave me a practical mindset that I now carry into software development: understand the system, make deliberate changes, and build things that can actually be maintained.',
    ],
  },
  {
    title: 'Software became the natural next step',
    paragraphs: [
      'The more I worked with infrastructure, the more interested I became in what was happening behind the systems I was supporting. I wanted to understand how the software itself was designed, not just how to deploy or troubleshoot it.',
      'That eventually led me into software development and HBO Informatica at Avans Hogeschool. Today I spend most of my time working with .NET, C#, TypeScript, React, APIs, databases, and the infrastructure around them.',
    ],
  },
  {
    title: 'I learn by building',
    paragraphs: [
      'A large part of my development happens outside the classroom. I build projects to understand technologies properly, test ideas, and solve problems that interest me.',
      'Projects such as OpenCaptive and DentechSync have taught me as much about architecture, deployment, integrations, authentication, observability, and product thinking as they have about writing code.',
    ],
  },
  {
    title: 'What I am working toward',
    paragraphs: [
      'I am still early in my software career, and I do not want to pretend otherwise. My goal is not to know everything already, but to keep becoming better at turning ideas into reliable software.',
      'I want to become the kind of developer who understands both the code and the environment around it: someone who can build, deploy, troubleshoot, improve, and take responsibility for the systems they create.',
    ],
  },
];

const timeline = [
  {
    period: '2019—2022',
    title: 'IT systems foundation',
    detail:
      'Started building a practical foundation in IT, networking, systems administration, troubleshooting, and infrastructure.',
  },
  {
    period: '2022—2023',
    title: 'MBO Level 4 — IT',
    detail:
      'Completed MBO Level 4 in IT and gained hands-on experience working with real systems and environments.',
  },
  {
    period: '2023—2024',
    title: 'From IT operations to software development',
    detail:
      'The focus gradually shifted from operating and supporting systems toward understanding and building the software behind them.',
  },
  {
    period: '2024—2026',
    title: 'HBO Informatica at Avans',
    detail:
      'Studying software development while building personal projects and continuing to work in IT.',
  },
  {
    period: '2026',
    title: 'Software development in practice',
    detail:
      'Preparing for an internship with the IT/AI team at Basic-Fit while continuing to build projects and deepen my software engineering skills.',
  },
];
---

<Layout
  title="About"
  description="An IT systems background, a growing focus on software development, and a habit of learning by building."
  person
>
  <PageHeader label="About">
    <span slot="title">From systems to software.</span>
    I started in IT infrastructure and support. Today, I am building toward a
    career in software development while keeping the systems perspective that
    got me here.
  </PageHeader>

  <div class="wrap">
    <section class="profile surface">
      <div class="portrait">
        <Image
          src={portrait}
          alt="Daniël van Ginneken"
          widths={[200, 320, 440]}
          sizes="(max-width: 40rem) 40vw, 11rem"
          format="webp"
          quality={78}
        />
      </div>

      <div class="profile-body">
        <p class="pill">
          <span class="dot" aria-hidden="true"></span>
          Software development student · IT background
        </p>

        <p class="muted">
          HBO Informatica student at Avans Hogeschool with an MBO Level 4
          background in IT. Based in the Netherlands. I work with .NET, C#,
          TypeScript, React, APIs, databases, and infrastructure, and I learn
          a lot of that by building things myself.
        </p>

        <SocialLinks email />
      </div>
    </section>

    <div class="sections">
      {
        sections.map((s) => (
          <section class="narrative">
            <h2>{s.title}</h2>
            <div class="prose">
              {s.paragraphs.map((p) => (
                <p class="muted">{p}</p>
              ))}
            </div>
          </section>
        ))
      }
    </div>

    <section class="timeline-section">
      <p class="section-label">Timeline</p>
      <h2>How I got here</h2>

      <ol class="timeline">
        {
          timeline.map((entry, i) => (
            <li class:list={{ current: i === timeline.length - 1 }}>
              <span class="marker" aria-hidden="true" />
              <p class="period">{entry.period}</p>
              <h3>{entry.title}</h3>
              <p class="muted detail">{entry.detail}</p>
            </li>
          ))
        }
      </ol>
    </section>
  </div>
</Layout>

<style>
  /* ── Profile card ──────────────────────────────────────────── */

  .profile {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: clamp(1.25rem, 4vw, 2.25rem);
    align-items: center;
    padding: clamp(1.5rem, 4vw, 2rem);
    margin-top: clamp(1rem, 3vw, 2rem);
  }

  .portrait {
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--bg-subtle);
  }

  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 12%;
  }

  .profile-body > * + * {
    margin-top: 1rem;
  }

  /* ── Narrative ─────────────────────────────────────────────── */

  .sections {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: clamp(1.75rem, 4vw, 2.5rem);
    align-items: start;
  }

  .narrative h2 {
    font-size: 1.125rem;
    letter-spacing: -0.01em;
    padding-bottom: 0.75rem;
    margin-bottom: 0.9rem;
    border-bottom: 1px solid var(--border);
  }

  .narrative .prose {
    max-width: none;
  }

  .narrative p {
    font-size: 0.9375rem;
  }

  /* ── Timeline ──────────────────────────────────────────────── */

  .timeline-section {
    margin-top: clamp(3rem, 7vw, 4.5rem);
    padding-top: clamp(2rem, 5vw, 3rem);
    border-top: 1px solid var(--border);
  }

  .timeline-section h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-top: 0.9rem;
  }

  .timeline {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }

  .timeline li {
    position: relative;
    padding-left: 2.25rem;
    padding-bottom: 2rem;
    max-width: var(--measure);
  }

  .timeline li:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 0.31rem;
    top: 1.1rem;
    bottom: -0.25rem;
    width: 1.5px;
    background: linear-gradient(
      to bottom,
      var(--border-strong),
      var(--border)
    );
  }

  .timeline li:last-child {
    padding-bottom: 0;
  }

  .marker {
    position: absolute;
    left: 0;
    top: 0.5rem;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    border: 2px solid var(--border-strong);
    background: var(--bg);
  }

  .current .marker {
    border-color: transparent;
    background: var(--gradient);
    box-shadow: 0 0 0 4px var(--accent-subtle);
  }

  .period {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .current .period {
    color: var(--accent);
  }

  .timeline h3 {
    font-size: 1.0625rem;
    margin-top: 0.3rem;
  }

  .detail {
    margin-top: 0.35rem;
    font-size: 0.9375rem;
  }

  /* ── Responsive ────────────────────────────────────────────── */

  @media (max-width: 40rem) {
    .profile {
      grid-template-columns: minmax(0, 1fr);
      justify-items: start;
    }

    .portrait {
      width: 9rem;
    }
  }
</style>