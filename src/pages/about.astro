---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import SocialLinks from '../components/SocialLinks.astro';
import portrait from '../images/portrait.jpg';

const sections = [
  {
    title: 'Where the technical foundation came from',
    paragraphs: [
      'My technical foundation started in support and infrastructure contexts where systems are live and consequences are immediate.',
      'That environment taught me to stay calm, diagnose carefully, and understand how one change affects everything connected to it.',
    ],
  },
  {
    title: 'What that background gave me',
    paragraphs: [
      'It gave me systems thinking and operational discipline early. I learned to ask what fails, why it fails, and what recovery requires.',
      'Those habits now carry into software work as attention to structure, reliability, and long-term maintainability.',
    ],
  },
  {
    title: 'Why software is the direction now',
    paragraphs: [
      'The move toward software was not a hard pivot. It was a natural next step from understanding systems to building them more directly.',
      'I am now focused on .NET, TypeScript, React, and API-driven development while keeping that infrastructure-aware lens.',
    ],
  },
  {
    title: 'What an internship changed',
    paragraphs: [
      'Interning with the IT/AI team at Basic-Fit moved my work from coursework projects to systems other people depend on.',
      'The difference is mostly in the parts that are not writing code: how changes get reviewed, how software is released, and how a team decides what is worth building. That context is difficult to simulate in a classroom.',
    ],
  },
  {
    title: 'What kind of builder I want to become',
    paragraphs: [
      'I want to build software that is technically clear, operationally responsible, and honest about scope.',
      'For me, a serious body of work means consistent quality, well-explained decisions, and steady progression over hype.',
    ],
  },
];

/**
 * Compact progression, folded in from the old standalone Journey page. The
 * narrative above tells this story properly; this exists because reviewers
 * scan for dates, and a second page repeating the same arc was not earning
 * its place in the nav.
 */
const timeline = [
  {
    period: '2019—2022',
    title: 'IT systems foundation',
    detail:
      'Support and infrastructure environments: Linux, networking, and troubleshooting on live systems.',
  },
  {
    period: '2022—2023',
    title: 'From operating systems to building them',
    detail:
      'Infrastructure work made software questions visible. The interest shifted from fixing systems to designing them.',
  },
  {
    period: '2023—2024',
    title: 'MBO Level 4 → HBO Informatica',
    detail:
      'Completed MBO Level 4 in IT, then started HBO Informatica at Avans Hogeschool.',
  },
  {
    period: '2024—2025',
    title: 'Projects and technical explorations',
    detail:
      'Learning turned into visible output: OpenCaptive, Aegis.Auth, and StrengthSuite.',
  },
  {
    period: 'Now',
    title: 'Third year, interning at Basic-Fit',
    detail:
      'Interning with the IT/AI team while continuing to deepen systems awareness.',
  },
];
---

<Layout
  title="About"
  description="Infrastructure first, software by intent — how a background in networking and systems operations shapes the way I build software."
  person
>
  <PageHeader label="About">
    <span slot="title">Infrastructure first. Software by intent.</span>
    Before I wrote software, I worked with the systems software depends on:
    networking, Linux, infrastructure support, and practical troubleshooting in
    real environments.
  </PageHeader>

  <div class="wrap">
    <!-- Portrait plus the one-line facts a reviewer scans for before reading. -->
    <section class="profile surface">
      <div class="portrait">
        <Image
          src={portrait}
          alt="Daniël van Ginneken"
          widths={[200, 320, 440]}
          sizes="(max-width: 40rem) 40vw, 11rem"
          format="webp"
          quality={78}
        />
      </div>

      <div class="profile-body">
        <p class="pill">
          <span class="dot" aria-hidden="true"></span>
          Interning with the IT/AI team at Basic-Fit
        </p>
        <p class="muted">
          Third year of HBO Informatica at Avans Hogeschool, after MBO Level 4
          in IT. Based in the Netherlands. Focused on .NET and TypeScript, and
          on building work that is honest about where I am now and deliberate
          about where I am going.
        </p>
        <SocialLinks email />
      </div>
    </section>

    <div class="sections">
      {
        sections.map((s) => (
          <section class="narrative">
            <h2>{s.title}</h2>
            <div class="prose">
              {s.paragraphs.map((p) => (
                <p class="muted">{p}</p>
              ))}
            </div>
          </section>
        ))
      }
    </div>

    <section class="timeline-section">
      <p class="section-label">Timeline</p>
      <h2>How I got here</h2>

      <ol class="timeline">
        {
          timeline.map((entry, i) => (
            <li class:list={{ current: i === timeline.length - 1 }}>
              <span class="marker" aria-hidden="true" />
              <p class="period">{entry.period}</p>
              <h3>{entry.title}</h3>
              <p class="muted detail">{entry.detail}</p>
            </li>
          ))
        }
      </ol>
    </section>
  </div>
</Layout>

<style>
  /* ── Profile card ──────────────────────────────────────────── */

  .profile {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: clamp(1.25rem, 4vw, 2.25rem);
    align-items: center;
    padding: clamp(1.5rem, 4vw, 2rem);
    margin-top: clamp(1rem, 3vw, 2rem);
  }

  .portrait {
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--bg-subtle);
  }

  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 12%;
  }

  .profile-body > * + * {
    margin-top: 1rem;
  }

  /* ── Narrative ─────────────────────────────────────────────── */

  .sections {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: clamp(1.75rem, 4vw, 2.5rem);
    align-items: start;
  }

  .narrative h2 {
    font-size: 1.125rem;
    letter-spacing: -0.01em;
    padding-bottom: 0.75rem;
    margin-bottom: 0.9rem;
    border-bottom: 1px solid var(--border);
  }

  .narrative .prose {
    max-width: none;
  }

  .narrative p {
    font-size: 0.9375rem;
  }

  /* ── Timeline ──────────────────────────────────────────────── */

  .timeline-section {
    margin-top: clamp(3rem, 7vw, 4.5rem);
    padding-top: clamp(2rem, 5vw, 3rem);
    border-top: 1px solid var(--border);
  }

  .timeline-section h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-top: 0.9rem;
  }

  .timeline {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }

  .timeline li {
    position: relative;
    padding-left: 2.25rem;
    padding-bottom: 2rem;
    max-width: var(--measure);
  }

  /* The rail is drawn per-item so the last entry's line stops at its own
     marker instead of trailing into empty space. */
  .timeline li:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 0.31rem;
    top: 1.1rem;
    bottom: -0.25rem;
    width: 1.5px;
    background: linear-gradient(
      to bottom,
      var(--border-strong),
      var(--border)
    );
  }

  .timeline li:last-child {
    padding-bottom: 0;
  }

  .marker {
    position: absolute;
    left: 0;
    top: 0.5rem;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    border: 2px solid var(--border-strong);
    background: var(--bg);
  }

  .current .marker {
    border-color: transparent;
    background: var(--gradient);
    box-shadow: 0 0 0 4px var(--accent-subtle);
  }

  .period {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .current .period {
    color: var(--accent);
  }

  .timeline h3 {
    font-size: 1.0625rem;
    margin-top: 0.3rem;
  }

  .detail {
    margin-top: 0.35rem;
    font-size: 0.9375rem;
  }

  /* ── Responsive ────────────────────────────────────────────── */

  @media (max-width: 40rem) {
    .profile {
      grid-template-columns: minmax(0, 1fr);
      justify-items: start;
    }

    .portrait {
      width: 9rem;
    }
  }
</style>
